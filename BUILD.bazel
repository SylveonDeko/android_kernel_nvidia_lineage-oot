load("//build/kernel/kleaf:kernel.bzl", "ddk_headers", "ddk_module")

package(default_visibility = ["//vendor/nvidia:__subpackages__"])

alias(
    name = "kernel",
    actual = "//vendor/nvidia/kernel:kernel_aarch64",
)

# Common headers
ddk_headers(
    name = "common_headers",
    hdrs = glob([
        "include/linux/**/*.h",
    ]),
    includes = ["include",],
)


# Gpu
ddk_module(
    name = "panel-jdi-58-1440-810",
    srcs = ["drivers/gpu/drm/panel/panel-jdi-58-1440-810.c"],
    out = "panel-jdi-58-1440-810.ko",
    kernel_build = ":kernel",
)


# Hid
ddk_module(
    name = "hid-nvidia-shield-oot",
    srcs = ["drivers/hid/hid-nvidia-shield-oot.c"],
    out = "hid-nvidia-shield-oot.ko",
    kernel_build = ":kernel",
)


# Input
ddk_module(
    name = "rm31080a_ctrl",
    srcs = ["drivers/input/touchscreen/rm31080a_ctrl.c"],
    out = "rm31080a_ctrl.ko",
    kernel_build = ":kernel",
    deps = [
        ":common_headers",
    ],
)
ddk_module(
    name = "rm31080a_ts",
    srcs = ["drivers/input/touchscreen/rm31080a_ts.c"],
    out = "rm31080a_ts.ko",
    kernel_build = ":kernel",
    deps = [
        ":common_headers",
        ":rm31080a_ctrl",
    ],
)


# Power
ddk_module(
    name = "lc709203f_battery",
    srcs = ["drivers/power/supply/lc709203f_battery.c"],
    out = "lc709203f_battery.ko",
    kernel_build = ":kernel",
)
